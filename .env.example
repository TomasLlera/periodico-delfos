# Copiar a .env.local y completar. NUNCA commitear .env.local.

# ── Sitio ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo server. Bypassea RLS: jamás en un componente cliente ni en NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# ── Inngest ──────────────────────────────────────────────
# Simula los posteos sin publicar nada: escribe social_posts con un id
# "simulado-…" y no le pega a ninguna red. Sin credenciales de Meta ni de X el
# pipeline simula igual, así que esto sirve para probarlo CON las claves
# puestas.
SOCIAL_DRY_RUN=true
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Meta (Facebook + Instagram) ──────────────────────────
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
# Token de Página de larga duración
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── X (API v2, OAuth 1.0a) ───────────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── Migración desde WordPress (sólo para scripts/migrate-wp.ts) ──
WP_MIGRATION_SOURCE=https://periodicodelfos.com

# ── Suite del panel (e2e) ────────────────────────────────
# Usuario de prueba con fila en `autores`: tener sesión de Auth no alcanza,
# el layout del panel rebota al login sin ella. Lo crea, con una clave nueva:
#   pnpm tsx scripts/usuario-e2e.ts --crear
# Sin estas dos, los tests del panel no se arman y la suite corre sin ellos.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Las cuentas del medio, para los iconos de la cabecera y la columna "Seguinos"
# del pie. Son URL completas y publicas: con `https://`, no el handle suelto
# (`@periodicodelfos` daria un link relativo a un 404 del propio sitio).
#
# No tienen nada que ver con los tokens del auto-posteo, que son secretos y
# viven mas arriba en este archivo. Estas son adonde va a mirar un lector.
#
# Cada una se dibuja solo si esta cargada: con el archivo asi, vacio, el chrome
# no muestra ningun icono y el pie no muestra la columna.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_URL_INSTAGRAM=
NEXT_PUBLIC_URL_X=
NEXT_PUBLIC_URL_YOUTUBE=
NEXT_PUBLIC_URL_FACEBOOK=

# ---------------------------------------------------------------------------
# Google Analytics 4. El identificador de medicion, con el formato G-XXXXXXXXXX.
# Sin esto el sitio no carga ningun script de terceros.
#
# Cargarla SOLO en produccion: en los previews de Vercel y en local las visitas
# del equipo ensucian las metricas del medio.
#
# Antes de prenderla hay que publicar la politica de privacidad: GA deja
# cookies y hoy el sitio no tiene esa pagina.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
