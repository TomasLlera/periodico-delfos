# Copiar a .env.local y completar. NUNCA commitear .env.local.

# ── Sitio ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sólo server. Bypassea RLS: jamás en un componente cliente ni en NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# ── Inngest ──────────────────────────────────────────────
# Simula los posteos sin publicar nada: escribe social_posts con un id
# "simulado-…" y no le pega a ninguna red. Sin credenciales de Meta ni de X el
# pipeline simula igual, así que esto sirve para probarlo CON las claves
# puestas.
SOCIAL_DRY_RUN=true
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Meta (Facebook + Instagram) ──────────────────────────
META_APP_ID=
META_APP_SECRET=
FACEBOOK_PAGE_ID=
# Token de Página de larga duración
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── X (API v2, OAuth 1.0a) ───────────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── Migración desde WordPress (sólo para scripts/migrate-wp.ts) ──
WP_MIGRATION_SOURCE=https://periodicodelfos.com
